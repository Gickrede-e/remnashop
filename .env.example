# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gickvpn?schema=public
POSTGRES_DB=gickvpn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Auth
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32 # REPLACE BEFORE PRODUCTION
ADMIN_EMAILS=admin@example.com
ADMIN_INITIAL_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=GickShop
SITE_ADDRESS=example.com

# Docker images
APP_IMAGE=gickrede/remnashop:latest

# Telegram (support link + admin-notification bot only; login-via-Telegram was removed)
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
TELEGRAM_BOT_TOKEN=

# Email flows
EMAIL_ENABLED=false

# Turnstile (set both keys at runtime, or leave both empty to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Remnawave
REMNAWAVE_BASE_URL=https://your-panel.example.com
REMNAWAVE_API_TOKEN=REPLACE_WITH_REMNAWAVE_API_TOKEN # REPLACE BEFORE PRODUCTION

# YooKassa
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=REPLACE_WITH_YOOKASSA_SECRET_KEY # REPLACE BEFORE PRODUCTION

# Platega.io (cabinet → Настройки). Callback URL: https://<site>/api/webhook/platega
# Methods: 2 = СБП, 10 = Карты РФ, 13 = Крипта
PLATEGA_ENABLED=false
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=REPLACE_WITH_PLATEGA_API_KEY # REPLACE BEFORE PRODUCTION
PLATEGA_PAYMENT_METHODS=2,10,13

# SMTP configuration
# Defaults below use the built-in Maddy container.
# For Google Workspace, keep MAIL_* filled and override SMTP_* / EMAIL_FROM
# as documented in docs/SMTP-GOOGLE-WORKSPACE.md.
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_DKIM_SELECTOR=mail
SMTP_HOST=smtp
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GickShop <notifications@example.com>"

# Referral system
REFERRAL_REWARD_TYPE=FREE_DAYS
REFERRAL_REWARD_VALUE=3

# Cron
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_16 # REPLACE BEFORE PRODUCTION

# Backups (compose `backup` service + scripts/backup.sh use the same passphrase)
BACKUP_GPG_PASSPHRASE=REPLACE_WITH_OPENSSL_RAND_BASE64_24 # REPLACE BEFORE PRODUCTION
# BACKUP_INTERVAL_SECONDS=86400  # optional, default: 24h
# BACKUP_RETENTION_DAYS=7        # optional, default: 7 days

# Logging
LOG_LEVEL=info
# LOG_FORMAT=json    # optional, default: pretty in dev / json in prod
