generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VerificationTokenType {
  REGISTRATION
  PASSWORD_RESET
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  DISABLED
  EXPIRED
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
}

enum PaymentProvider {
  YOOKASSA
  PLATEGA
}

enum PromoCodeType {
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_DAYS
  FREE_TRAFFIC_GB
}

enum PromoUsageStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SupportSender {
  USER
  ADMIN
}

enum SupportThreadStatus {
  OPEN
  CLOSED
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  passwordHash        String
  remnawaveUuid       String?          @unique @map("remnawave_uuid")
  remnawaveUsername   String?
  remnawaveShortUuid  String?
  role                Role             @default(USER)
  // Bumped on password change / reset to invalidate all previously-issued session
  // JWTs (which embed this value and are rejected server-side when it no longer matches).
  sessionVersion      Int              @default(0)
  referralCode        String           @unique @default(cuid())
  referredById        String?
  referredBy          User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]           @relation("Referrals")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  payments            Payment[]
  subscription        Subscription?
  promoUsages         PromoUsage[]
  referralRewards     ReferralReward[] @relation("ReferralRewardOwner")
  referralSources     ReferralReward[] @relation("ReferralRewardSource")
  adminLogs           AdminLog[]
  supportThread       SupportThread?

  @@index([role])
  @@map("users")
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  planId              String
  status              SubscriptionStatus @default(PENDING)
  startsAt            DateTime?
  expiresAt           DateTime?
  trafficLimitBytes   BigInt?
  trafficUsedBytes    BigInt?            @default(0)
  remnawaveLastSyncAt DateTime?
  grantedByAdminId    String?
  grantNote           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id])
  payments            Payment[]

  @@index([status])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  planId            String
  subscriptionId    String?
  provider          PaymentProvider
  externalPaymentId String?         @unique
  amount            Int
  originalAmount    Int?
  months            Int             @default(1)
  currency          String          @default("RUB")
  status            PaymentStatus   @default(PENDING)
  confirmationUrl   String?
  providerPayload   Json?
  activationConfirmedAt DateTime?
  activationMeta    Json?
  activationAttemptedAt DateTime?
  promoCodeId       String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan            @relation(fields: [planId], references: [id])
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  promoCode         PromoCode?      @relation(fields: [promoCodeId], references: [id])

  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@index([userId])
  @@index([planId])
  @@index([promoCodeId])
  @@index([userId, activationConfirmedAt])
  @@map("payments")
}

model Plan {
  id                         String         @id @default(cuid())
  slug                       String         @unique
  name                       String
  description                String?
  durationDays               Int
  trafficGB                  Int
  price                      Int
  isActive                   Boolean        @default(true)
  highlight                  String?
  sortOrder                  Int            @default(0)
  remnawaveExternalSquadUuid String?
  remnawaveInternalSquadUuids String[]      @default([])
  remnawaveHwidDeviceLimit   Int?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  subscriptions              Subscription[]
  payments                   Payment[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model PromoCode {
  id               String        @id @default(cuid())
  code             String        @unique
  type             PromoCodeType
  value            Int
  maxUsages        Int?
  currentUsages    Int           @default(0)
  maxUsagesPerUser Int           @default(1)
  minAmount        Int?
  applicablePlanIds String[]     @default([])
  startsAt         DateTime      @default(now())
  expiresAt        DateTime?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  usages           PromoUsage[]
  payments         Payment[]

  @@index([isActive, code])
  @@map("promo_codes")
}

model PromoUsage {
  id          String           @id @default(cuid())
  promoCodeId String
  userId      String
  paymentId   String?
  status      PromoUsageStatus @default(PENDING)
  usedAt      DateTime         @default(now())
  promoCode   PromoCode        @relation(fields: [promoCodeId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId, paymentId])
  @@index([promoCodeId, status])
  @@index([userId])
  @@map("promo_usages")
}

model ReferralReward {
  id             String   @id @default(cuid())
  ownerId        String
  referredUserId String
  rewardType     String
  rewardValue    Int
  applied        Boolean  @default(false)
  paymentId      String?
  createdAt      DateTime @default(now())
  owner          User     @relation("ReferralRewardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  referredUser   User     @relation("ReferralRewardSource", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([ownerId, applied])
  @@index([referredUserId])
  @@unique([ownerId, referredUserId, paymentId])
  @@map("referral_rewards")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())
  admin      User?    @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([targetType, targetId])
  @@index([adminId])
  @@index([createdAt])
  @@map("admin_logs")
}

model VerificationToken {
  id          String                @id @default(cuid())
  email       String
  codeHash    String
  type        VerificationTokenType
  data        Json?
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)
  createdAt   DateTime              @default(now())

  @@index([email, type])
  @@map("verification_tokens")
}

model WebhookDelivery {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  externalEventId String
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@map("webhook_deliveries")
}

// Legacy chat tables are retained to preserve existing conversations.
// The site no longer reads or writes them.
model SupportThread {
  id                String              @id @default(cuid())
  userId            String              @unique
  status            SupportThreadStatus @default(OPEN)
  // Денормализация для списка в админке: сортировка и бейджи непрочитанного
  // без агрегатных запросов по сообщениям.
  lastMessageAt     DateTime            @default(now())
  lastMessageSender SupportSender       @default(USER)
  // Непрочитанные админом (входящие от пользователя) и пользователем (ответы админа).
  adminUnreadCount  Int                 @default(0)
  userUnreadCount   Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@map("support_threads")
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  sender    SupportSender
  body      String
  createdAt DateTime      @default(now())
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("support_messages")
}
